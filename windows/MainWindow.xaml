<Window x:Class="RedCast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RedCast.UI"
        xmlns:core="clr-namespace:RedCast.Core"
        Title="RedCast"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Width="560" Height="720" MinWidth="440" MinHeight="54"
        FontFamily="Segoe UI" Foreground="{StaticResource Fg}"
        Opacity="{Binding Settings.Opacity}">
    <Border CornerRadius="12" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <!-- ========== Compact bar ========== -->
            <Grid x:Name="CompactBar" Visibility="Collapsed" Margin="10,0" MouseLeftButtonDown="Drag">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="CompactDot" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center" Margin="2,0,10,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CompactStart" Style="{StaticResource Btn}" Padding="10,4" Click="Start_Click" Margin="0,0,6,0"/>
                    <Button x:Name="CompactAnswer" Style="{StaticResource Btn}" Padding="10,4" Content="⚡" ToolTip="Ответить сейчас" Click="Answer_Click" Margin="0,0,6,0"/>
                    <Button x:Name="CompactRecI" Style="{StaticResource Btn}" Padding="10,4" Click="RecI_Click" Margin="0,0,6,0"/>
                    <Button x:Name="CompactRecMe" Style="{StaticResource Btn}" Padding="10,4" Click="RecMe_Click" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource Btn}" Padding="10,4" Content="📷" ToolTip="Скриншот → решение" Click="Screenshot_Click" Margin="0,0,8,0"/>
                </StackPanel>
                <TextBlock x:Name="CompactText" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontSize="12.5" FontWeight="SemiBold"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconBtn}" Content="⤢" ToolTip="Развернуть" Click="Compact_Click" Margin="6,0,4,0"/>
                    <Button Style="{StaticResource IconBtn}" Content="✕" ToolTip="Скрыть окно (вернуть — значок в трее)" Click="Hide_Click"/>
                </StackPanel>
            </Grid>

            <!-- ========== Full view ========== -->
            <DockPanel x:Name="FullView">
                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="14,12,14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="Transparent" MouseLeftButtonDown="Drag" Cursor="SizeAll" ToolTip="Перетащите, чтобы переместить окно">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                                    <TextBlock Text="{Binding ModelStatus}" FontSize="10.5" Foreground="{StaticResource Fg2}" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0">
                            <Button x:Name="TabHints" Style="{StaticResource Btn}" Content="Подсказки" Padding="10,4" Click="TabHints_Click"/>
                            <Button x:Name="TabSettings" Style="{StaticResource Btn}" Content="Настройки" Padding="10,4" Margin="4,0,0,0" Click="TabSettings_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource IconBtn}" Content="—" ToolTip="Свернуть в полоску" Click="Compact_Click" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource IconBtn}" Content="✕" ToolTip="Скрыть окно (вернуть — значок в трее)" Click="Hide_Click"/>
                        </StackPanel>
                    </Grid>
                    <ProgressBar Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding ModelProgress}"
                                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>
                    <!-- Error banner -->
                    <Border Background="#33FFC107" CornerRadius="8" Padding="10,8" Margin="0,8,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="✕" Click="DismissError_Click" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="12"/>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <Grid>
                <!-- ===== Hints tab ===== -->
                <Grid x:Name="HintsView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="14,0,14,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource Btn}" Content="📷 Скриншот" Click="Screenshot_Click" ToolTip="Решить задачу с экрана" Margin="0,0,4,0"/>
                                <Button Style="{StaticResource Btn}" Content="🗑" Click="Clear_Click" ToolTip="Очистить"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ModeAuto" Style="{StaticResource Btn}" Content="Авто" Padding="14,5" Click="ModeAuto_Click"
                                        ToolTip="RedCast сам слышит вопросы интервьюера и отвечает"/>
                                <Button x:Name="ModeManual" Style="{StaticResource Btn}" Content="По кнопкам" Padding="14,5" Margin="4,0,0,0" Click="ModeManual_Click"
                                        ToolTip="Вы сами отмечаете начало и конец вопроса двумя кнопками"/>
                            </StackPanel>
                        </DockPanel>
                        <Grid Margin="0,8,0,0">
                            <!-- Auto -->
                            <StackPanel x:Name="AutoButtons" Orientation="Horizontal">
                                <Button x:Name="StartButton" Style="{StaticResource Btn}" FontSize="14" FontWeight="SemiBold" Padding="18,8" MinWidth="110" Click="Start_Click"/>
                                <Button Style="{StaticResource Btn}" Content="⚡ Ответить сейчас" Padding="14,8" Margin="8,0,0,0" Click="Answer_Click" ToolTip="Не ждать паузы"/>
                            </StackPanel>
                            <!-- Manual -->
                            <Grid x:Name="ManualButtons" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="RecIButton" Style="{StaticResource Btn}" Padding="10,8" Click="RecI_Click"
                                        ToolTip="Нажмите, когда интервьюер начал вопрос, и ещё раз — когда закончил"/>
                                <Button x:Name="RecMeButton" Grid.Column="2" Style="{StaticResource Btn}" Padding="10,8" Click="RecMe_Click"
                                        ToolTip="Нажмите и говорите (например, повторите вопрос), нажмите ещё раз — получите подсказку"/>
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <ScrollViewer x:Name="AnswersScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,0">
                        <StackPanel>
                            <TextBlock x:Name="EmptyHint" TextWrapping="Wrap" Foreground="{StaticResource Fg2}" FontSize="13" Margin="0,4,0,0"/>
                            <ItemsControl ItemsSource="{Binding Answers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Latency}" FontSize="10.5" Foreground="{StaticResource Fg2}" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding Question}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Fg2}"/>
                                                </DockPanel>
                                                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,2,0,4"
                                                             Visibility="{Binding ShowSpinner, Converter={StaticResource BoolToVis}}"/>
                                                <ContentControl ui:Markdown.Text="{Binding Text}" Foreground="{StaticResource Fg}"/>
                                                <TextBlock Text="{Binding Error}" Foreground="#FFFF6B6B" TextWrapping="Wrap" FontSize="12"
                                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" x:Name="TranscriptToggle" Style="{StaticResource Btn}" Background="Transparent"
                            Foreground="{StaticResource Fg2}" HorizontalAlignment="Left" Padding="14,4" FontSize="11.5"
                            Content="▾ Расшифровка" Click="TranscriptToggle_Click"/>
                    <ScrollViewer Grid.Row="3" x:Name="TranscriptScroll" Height="120" VerticalScrollBarVisibility="Auto" Padding="14,0">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,1">
                                            <Run Text="{Binding Label, Mode=OneWay}" FontWeight="Bold" Foreground="{Binding IsInterviewer, Mode=OneWay, Converter={StaticResource SpeakerBrush}}"/><Run Text="{Binding Text, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock TextWrapping="Wrap" FontSize="12" FontStyle="Italic" Foreground="{StaticResource Fg2}"
                                       Visibility="{Binding PartialInterviewer, Converter={StaticResource TextToVis}}">
                                <Run Text="Интервьюер: " FontWeight="Bold" Foreground="{StaticResource Orange}"/><Run Text="{Binding PartialInterviewer, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="12" FontStyle="Italic" Foreground="{StaticResource Fg2}"
                                       Visibility="{Binding PartialMe, Converter={StaticResource TextToVis}}">
                                <Run Text="Я: " FontWeight="Bold" Foreground="{StaticResource Accent}"/><Run Text="{Binding PartialMe, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="4" Background="#22000000" CornerRadius="0,0,12,12" Padding="14,8,30,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="⌨" Foreground="{StaticResource Fg2}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="ManualInput" KeyDown="ManualInput_KeyDown" ToolTip="Вопрос текстом → Enter"/>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ===== Settings tab ===== -->
                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,0,16,24">
                        <TextBlock Style="{StaticResource H}" Text="1. Подключение Claude" Margin="0,4,0,6"/>
                        <ComboBox ItemsSource="{x:Static core:Catalog.Backends}" SelectedValuePath="Id" DisplayMemberPath="Title"
                                  SelectedValue="{Binding Settings.Backend}" SelectionChanged="Backend_Changed"/>
                        <StackPanel x:Name="ApiPanel">
                            <TextBlock Style="{StaticResource Label}" Text="API-ключ (sk-ant-…)"/>
                            <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKey_Changed"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Ключ: platform.claude.com → API Keys. Оплата по факту, отдельно от подписки. Хранится зашифрованным в вашей учётной записи Windows."/>
                            <CheckBox Content="Fast mode — ещё быстрее вывод (только Opus 5.5, цена ×2)" IsChecked="{Binding Settings.FastMode}"/>
                        </StackPanel>
                        <StackPanel x:Name="CliPanel">
                            <TextBlock Style="{StaticResource Label}" Text="Путь к claude.exe (пусто = найти автоматически)"/>
                            <TextBox Text="{Binding Settings.ClaudePath, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Один раз в PowerShell: claude → /login. Расходует лимит вашей подписки."/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Модель"/>
                        <ComboBox ItemsSource="{x:Static core:Catalog.Models}" SelectedValuePath="Id" DisplayMemberPath="Title" SelectedValue="{Binding Settings.Model}"/>
                        <TextBlock Style="{StaticResource Label}" Text="Глубина размышлений"/>
                        <ComboBox ItemsSource="{x:Static core:Catalog.Efforts}" SelectedValuePath="Id" DisplayMemberPath="Title" SelectedValue="{Binding Settings.Effort}"/>
                        <Button Style="{StaticResource Btn}" Content="Проверить соединение" HorizontalAlignment="Left" Margin="0,10,0,0" Click="TestConnection_Click"/>

                        <TextBlock Style="{StaticResource H}" Text="2. Распознавание речи"/>
                        <TextBlock Style="{StaticResource Label}" Text="Язык собеседования"/>
                        <ComboBox ItemsSource="{x:Static core:Catalog.SpeechLanguages}" SelectedValuePath="Id" DisplayMemberPath="Title" SelectedValue="{Binding Settings.SpeechLanguage}"/>
                        <TextBlock Style="{StaticResource Label}" Text="Модель распознавания"/>
                        <ComboBox ItemsSource="{x:Static core:Catalog.WhisperModels}" SelectedValuePath="Id" DisplayMemberPath="Title" SelectedValue="{Binding Settings.WhisperModel}"/>
                        <CheckBox Content="Использовать видеокарту (быстрее в 3–10 раз)" IsChecked="{Binding Settings.UseGpu}"/>
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Перезагрузить модель" Click="ReloadModel_Click"/>
                            <TextBlock Text="{Binding ModelStatus}" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Словарь терминов (технологии, компании, имена)"/>
                        <TextBox Text="{Binding Settings.Vocabulary, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="56"/>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding Settings.SilenceMs, StringFormat='Пауза конца вопроса: {0:0} мс'}"/>
                        <Slider Minimum="400" Maximum="1500" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding Settings.SilenceMs}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Меньше — быстрее подсказка, но вопрос чаще разбивается на части."/>
                        <CheckBox Content="Авто: отвечать на каждую реплику интервьюера" IsChecked="{Binding Settings.AutoAnswer}"/>
                        <CheckBox Content="Авто: распознавать мой микрофон (чтобы понимать, что я уже ответил)" IsChecked="{Binding Settings.CaptureMic}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Наденьте наушники — иначе микрофон слышит интервьюера из динамиков. Такие повторы RedCast отбрасывает, но с наушниками надёжнее всего."/>

                        <TextBlock Style="{StaticResource H}" Text="3. Профиль кандидата"/>
                        <TextBlock Style="{StaticResource Label}" Text="Язык подсказок"/>
                        <ComboBox ItemsSource="{x:Static core:Catalog.AnswerLanguages}" SelectedValuePath="Id" DisplayMemberPath="Title" SelectedValue="{Binding Settings.AnswerLanguage}"/>
                        <DockPanel Margin="0,8,0,3">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="8,2" FontSize="11.5" Content="Из файла…" Click="ImportResume_Click"/>
                            <TextBlock Style="{StaticResource Label}" Margin="0" Text="Резюме"/>
                        </DockPanel>
                        <TextBox Text="{Binding Settings.Resume, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="120" VerticalScrollBarVisibility="Auto"/>
                        <DockPanel Margin="0,8,0,3">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Padding="8,2" FontSize="11.5" Content="Из файла…" Click="ImportJob_Click"/>
                            <TextBlock Style="{StaticResource Label}" Margin="0" Text="Вакансия"/>
                        </DockPanel>
                        <TextBox Text="{Binding Settings.JobDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Style="{StaticResource Label}" Text="Указания (грейд, стиль, что подчеркнуть)"/>
                        <TextBox Text="{Binding Settings.ExtraInstructions, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="56"/>

                        <TextBlock Style="{StaticResource H}" Text="4. Окно"/>
                        <CheckBox Content="Скрывать окно при демонстрации экрана" IsChecked="{Binding Settings.HideFromCapture}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Проверьте тестовым звонком: окна не должно быть видно у собеседника (Windows 10 2004 и новее)."/>
                        <TextBlock Style="{StaticResource Label}" Text="Непрозрачность"/>
                        <Slider Minimum="0.4" Maximum="1" Value="{Binding Settings.Opacity}"/>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding Settings.FontSize, StringFormat='Размер шрифта: {0:0}'}"/>
                        <Slider Minimum="11" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.FontSize}"/>

                        <TextBlock Style="{StaticResource H}" Text="5. Горячие клавиши (работают в любом приложении)"/>
                        <StackPanel x:Name="HotKeysPanel"/>
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Сбросить" Click="ResetHotKeys_Click"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Нажмите на сочетание и введите новое. Esc — отмена. Нужен Ctrl, Alt, Shift или Win (кроме F1–F12)."/>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Style="{StaticResource Btn}" Content="Папка с записями собеседований" Click="OpenSessions_Click"/>
                            <Button Style="{StaticResource Btn}" Content="Выйти из RedCast" Margin="8,0,0,0" Click="Quit_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>
