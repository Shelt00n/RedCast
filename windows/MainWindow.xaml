<Window x:Class="RedCast.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RedCast.UI"
        xmlns:core="clr-namespace:RedCast.Core"
        Title="RedCast"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Width="560" Height="720" MinWidth="440" MinHeight="52"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource Fg}"
        TextOptions.TextFormattingMode="Display"
        Opacity="{Binding Settings.Opacity}">
    <!-- Resize from every edge and corner (the window has no system frame) -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0"
                      CornerRadius="12" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border CornerRadius="12" Background="{StaticResource Bg}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1">
        <Grid>
            <!-- ========== Compact bar ========== -->
            <Grid x:Name="CompactBar" Visibility="Collapsed" Margin="12,0,8,0" Background="Transparent" MouseLeftButtonDown="Drag"
                  ToolTip="Потяните, чтобы переместить окно">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Ellipse x:Name="CompactRing" Width="16" Height="16" Stroke="{StaticResource AccentSoft}" StrokeThickness="2" Visibility="Collapsed"/>
                    <Ellipse x:Name="CompactDot" Width="8" Height="8" Fill="{StaticResource Idle}"/>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CompactStart" Style="{StaticResource IconBtn}" Click="Start_Click" Margin="0,0,4,0"/>
                    <Button x:Name="CompactAnswer" Style="{StaticResource IconBtn}" Content="&#xE945;" ToolTip="Ответить сейчас" Click="Answer_Click" Margin="0,0,4,0"/>
                    <Button x:Name="CompactRecI" Style="{StaticResource IconBtn}" Click="RecI_Click" Margin="0,0,4,0" ToolTip="Интервьюер"/>
                    <Button x:Name="CompactRecMe" Style="{StaticResource IconBtn}" Click="RecMe_Click" Margin="0,0,4,0" ToolTip="Я"/>
                    <Button Style="{StaticResource IconBtn}" Content="&#xE722;" ToolTip="Задача со скриншота" Click="Screenshot_Click" Margin="0,0,12,0"/>
                </StackPanel>
                <TextBlock x:Name="CompactText" Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontSize="14" FontWeight="Medium"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Style="{StaticResource IconBtn}" Content="&#xE740;" ToolTip="Развернуть" Click="Compact_Click"/>
                    <Button Style="{StaticResource IconBtn}" Content="&#xE8BB;" FontSize="12" ToolTip="Скрыть окно (вернуть — значок в трее)" Click="Hide_Click"/>
                </StackPanel>
            </Grid>

            <!-- ========== Full view ========== -->
            <DockPanel x:Name="FullView">
                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="16,8,8,12" Background="Transparent" MouseLeftButtonDown="Drag">
                    <Border Width="32" Height="4" CornerRadius="2" Background="{StaticResource LineStrong}" HorizontalAlignment="Center"
                            Margin="0,0,8,8" ToolTip="Потяните, чтобы переместить окно"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel Background="Transparent" ToolTip="{Binding Status}">
                            <!-- Tally: lit red while RedCast listens or records; the ring means the interviewer is speaking -->
                            <Grid DockPanel.Dock="Left" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse x:Name="StatusRing" Width="16" Height="16" Stroke="{StaticResource AccentSoft}" StrokeThickness="2" Visibility="Collapsed"/>
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Idle}"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Status}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ModelStatus}" FontSize="12" Foreground="{StaticResource Fg3}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Grid.Column="1" Style="{StaticResource Segmented}" VerticalAlignment="Center" Margin="8,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="TabHints" Style="{StaticResource SegBtn}" Content="Подсказки" Click="TabHints_Click"/>
                                <Button x:Name="TabSettings" Style="{StaticResource SegBtn}" Content="Настройки" Click="TabSettings_Click"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconBtn}" Content="&#xE921;" FontSize="12" ToolTip="Свернуть в полоску" Click="Compact_Click"/>
                            <Button Style="{StaticResource IconBtn}" Content="&#xE8BB;" FontSize="12" ToolTip="Скрыть окно (вернуть — значок в трее)" Click="Hide_Click"/>
                        </StackPanel>
                    </Grid>
                    <ProgressBar Margin="0,12,8,0" Minimum="0" Maximum="100" Value="{Binding ModelProgress}"
                                 Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>
                    <!-- Error banner -->
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource WarningLine}" BorderThickness="1"
                            CornerRadius="10" Padding="12,8,4,8" Margin="0,12,8,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource Warning}"
                                       VerticalAlignment="Top" Margin="0,2,12,0"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE8BB;" FontSize="10" Width="28" Height="28" MinHeight="28"
                                    Click="DismissError_Click" VerticalAlignment="Top" ToolTip="Закрыть"/>
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="13" LineHeight="20" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <Grid>
                <!-- ===== Hints tab ===== -->
                <Grid x:Name="HintsView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="16,0,16,16" Background="Transparent" MouseLeftButtonDown="Drag">
                        <!-- Update available -->
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="10" Padding="12,8,8,8" Margin="0,0,0,12"
                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{StaticResource Positive}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryBtn}" Content="Обновить" Click="InstallUpdate_Click"
                                        IsEnabled="{Binding NotUpdating}"/>
                                <TextBlock VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                                           Text="{Binding UpdateStatus}"/>
                            </DockPanel>
                        </Border>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource Btn}" Click="Screenshot_Click" ToolTip="Решить задачу с экрана" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE722;" Style="{StaticResource Icon}" Foreground="{StaticResource Fg2}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Скриншот" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" Click="Clear_Click" ToolTip="Очистить подсказки и расшифровку"/>
                            </StackPanel>
                            <Border Style="{StaticResource Segmented}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ModeAuto" Style="{StaticResource SegBtn}" Content="Авто" Click="ModeAuto_Click"
                                            ToolTip="RedCast сам слышит вопросы интервьюера и отвечает"/>
                                    <Button x:Name="ModeManual" Style="{StaticResource SegBtn}" Content="По кнопкам" Click="ModeManual_Click"
                                            ToolTip="Вы сами отмечаете начало и конец вопроса двумя кнопками"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                        <Grid Margin="0,12,0,0">
                            <!-- Auto -->
                            <StackPanel x:Name="AutoButtons" Orientation="Horizontal">
                                <Button x:Name="StartButton" Style="{StaticResource PrimaryBtn}" FontSize="14" Height="40" Padding="20,0" MinWidth="120" Click="Start_Click"/>
                                <Button Style="{StaticResource Btn}" Height="40" Padding="16,0" Margin="8,0,0,0" Click="Answer_Click" ToolTip="Не ждать паузы">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Foreground="{StaticResource Fg2}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Ответить сейчас" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <!-- Manual -->
                            <Grid x:Name="ManualButtons" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="RecIButton" Style="{StaticResource Btn}" Height="56" Padding="12,0" Click="RecI_Click"
                                        ToolTip="Нажмите, когда интервьюер начал вопрос, и ещё раз — когда закончил"/>
                                <Button x:Name="RecMeButton" Grid.Column="2" Style="{StaticResource Btn}" Height="56" Padding="12,0" Click="RecMe_Click"
                                        ToolTip="Нажмите и говорите (например, повторите вопрос), нажмите ещё раз — получите подсказку"/>
                            </Grid>
                        </Grid>
                    </StackPanel>

                    <ScrollViewer x:Name="AnswersScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0,8,0">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock x:Name="EmptyHint" TextWrapping="Wrap" Foreground="{StaticResource Fg2}" FontSize="13" LineHeight="20" Margin="0,4,0,0"/>
                            <ItemsControl ItemsSource="{Binding Answers}" Margin="0,0,0,16">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                CornerRadius="12" Padding="16,12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- On-air rule: the answer being read right now -->
                                                <Border Width="2" CornerRadius="1" Background="{StaticResource Accent}" Margin="0,4,12,4"
                                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}"/>
                                                <StackPanel Grid.Column="1">
                                                    <DockPanel Background="Transparent" Cursor="Hand"
                                                               MouseLeftButtonUp="AnswerHeader_Click" ToolTip="Свернуть или развернуть ответ">
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Chevron}" Style="{StaticResource Icon}" FontSize="10"
                                                                   Foreground="{StaticResource Fg3}" Margin="0,4,8,0" VerticalAlignment="Top"/>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Latency}" FontSize="12" Typography.NumeralAlignment="Tabular"
                                                                   Foreground="{StaticResource Fg3}" Margin="12,1,0,0" VerticalAlignment="Top"/>
                                                        <TextBlock Text="{Binding Question}" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                                                                   Foreground="{StaticResource Fg2}" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <ProgressBar IsIndeterminate="True" Height="2" Margin="0,8,0,0"
                                                                 Visibility="{Binding ShowSpinner, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding Preview}" FontWeight="Medium" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"
                                                               Visibility="{Binding IsExpanded, Converter={StaticResource InvBoolToVis}}"/>
                                                    <ContentControl ui:Markdown.Text="{Binding Text}" Foreground="{StaticResource Fg}" Margin="0,8,0,0"
                                                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Negative}" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0"
                                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" x:Name="TranscriptToggle" Style="{StaticResource GhostBtn}" HorizontalAlignment="Left"
                            Margin="8,0,0,4" Padding="8,0" FontSize="12" Click="TranscriptToggle_Click"/>
                    <ScrollViewer Grid.Row="3" x:Name="TranscriptScroll" Height="120" VerticalScrollBarVisibility="Auto" Padding="16,0,8,8">
                        <StackPanel Margin="0,0,8,0">
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="0,0,0,4" Foreground="{StaticResource Fg2}">
                                            <Run Text="{Binding Label, Mode=OneWay}" FontWeight="Medium" Foreground="{Binding IsInterviewer, Mode=OneWay, Converter={StaticResource SpeakerBrush}}"/><Run Text="{Binding Text, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{StaticResource Fg3}"
                                       Visibility="{Binding PartialInterviewer, Converter={StaticResource TextToVis}}">
                                <Run Text="Интервьюер: " FontWeight="Medium"/><Run Text="{Binding PartialInterviewer, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{StaticResource Fg3}"
                                       Visibility="{Binding PartialMe, Converter={StaticResource TextToVis}}">
                                <Run Text="Я: " FontWeight="Medium"/><Run Text="{Binding PartialMe, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="4" Background="{StaticResource BgDeep}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,12,12" Padding="16,12,32,12">
                        <TextBox x:Name="ManualInput" KeyDown="ManualInput_KeyDown" Background="{StaticResource Surface}"
                                 Tag="Вопрос текстом — Enter"/>
                    </Border>
                </Grid>

                <!-- ===== Settings tab ===== -->
                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel Margin="16,0,8,32">
                        <TextBlock Style="{StaticResource H}" Text="1. Подключение Claude" Margin="0,4,0,12"/>
                        <ComboBox ItemsSource="{x:Static core:Catalog.Backends}" SelectedValuePath="Id" DisplayMemberPath="Title"
                                  SelectedValue="{Binding Settings.Backend}" SelectionChanged="Backend_Changed"/>
                        <StackPanel x:Name="ApiPanel">
                            <TextBlock Style="{StaticResource Label}" Text="API-ключ (sk-ant-…)"/>
                            <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKey_Changed"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Ключ: platform.claude.com → API Keys. Оплата по факту, отдельно от подписки. Хранится зашифрованным в вашей учётной записи Windows."/>
                            <CheckBox Content="Fast mode: ещё быстрее вывод (только Opus 5.5, цена ×2)" IsChecked="{Binding Settings.FastMode}"/>
                        </StackPanel>
                        <StackPanel x:Name="CliPanel">
                            <TextBlock Style="{StaticResource Label}" Text="Путь к claude.exe (пусто — найти автоматически)"/>
                            <TextBox Text="{Binding Settings.ClaudePath, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Один раз в PowerShell: claude → /login. Расходует лимит вашей подписки."/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Модель"/>
                        <ComboBox ItemsSource="{x:Static core:Catalog.Models}" SelectedValuePath="Id" DisplayMemberPath="Title" SelectedValue="{Binding Settings.Model}"/>
                        <TextBlock Style="{StaticResource Label}" Text="Глубина размышлений"/>
                        <ComboBox ItemsSource="{x:Static core:Catalog.Efforts}" SelectedValuePath="Id" DisplayMemberPath="Title" SelectedValue="{Binding Settings.Effort}"/>
                        <Button Style="{StaticResource Btn}" Content="Проверить соединение" HorizontalAlignment="Left" Margin="0,16,0,0" Click="TestConnection_Click"/>

                        <TextBlock Style="{StaticResource H}" Text="2. Распознавание речи"/>
                        <TextBlock Style="{StaticResource Label}" Text="Язык собеседования"/>
                        <ComboBox ItemsSource="{x:Static core:Catalog.SpeechLanguages}" SelectedValuePath="Id" DisplayMemberPath="Title" SelectedValue="{Binding Settings.SpeechLanguage}"/>
                        <TextBlock Style="{StaticResource Label}" Text="Модель распознавания"/>
                        <ComboBox ItemsSource="{x:Static core:Catalog.WhisperModels}" SelectedValuePath="Id" DisplayMemberPath="Title" SelectedValue="{Binding Settings.WhisperModel}"/>
                        <CheckBox Content="Использовать видеокарту (быстрее в 3–10 раз)" IsChecked="{Binding Settings.UseGpu}"/>
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Перезагрузить модель" Click="ReloadModel_Click" Margin="12,0,0,0"/>
                            <TextBlock Text="{Binding ModelStatus}" Style="{StaticResource Hint}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Словарь терминов (технологии, компании, имена)"/>
                        <TextBox Text="{Binding Settings.Vocabulary, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="64" VerticalContentAlignment="Top"/>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding Settings.SilenceMs, StringFormat='Пауза конца вопроса: {0:0} мс'}"/>
                        <Slider Minimum="400" Maximum="1500" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding Settings.SilenceMs}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Меньше — быстрее подсказка, но вопрос чаще разбивается на части."/>
                        <TextBlock Style="{StaticResource Label}" Text="Микрофон"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE72C;" Margin="4,0,0,0"
                                    ToolTip="Обновить список (подключили наушники или USB-микрофон)" Click="RefreshMics_Click"/>
                            <ComboBox x:Name="MicCombo" ItemsSource="{Binding MicDevices}" SelectedValuePath="Id" DisplayMemberPath="Title"
                                      SelectedValue="{Binding Settings.MicDeviceId}" SelectionChanged="Mic_Changed"/>
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Left" Style="{StaticResource Btn}" Content="{Binding MicTestLabel}" Click="MicTest_Click" Margin="0,0,12,0"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding MicLevel}" VerticalAlignment="Center"
                                         Foreground="{StaticResource Positive}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Нажмите «Проверить» и скажите что-нибудь: полоска должна двигаться. Если она стоит на месте, выберите другой микрофон."/>
                        <CheckBox Content="Авто: отвечать на каждую реплику интервьюера" IsChecked="{Binding Settings.AutoAnswer}" Margin="0,16,0,0"/>
                        <CheckBox Content="Авто: распознавать мой микрофон (чтобы понимать, что я уже ответил)" IsChecked="{Binding Settings.CaptureMic}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Наденьте наушники — иначе микрофон слышит интервьюера из динамиков. Такие повторы RedCast отбрасывает, но с наушниками надёжнее всего."/>

                        <TextBlock Style="{StaticResource H}" Text="3. Как отвечать и профиль"/>
                        <DockPanel Margin="0,16,0,8">
                            <Button x:Name="FormatPresetsButton" DockPanel.Dock="Right" Style="{StaticResource Btn}" Click="FormatPresets_Click" Height="28" MinHeight="28">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Шаблоны" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" Foreground="{StaticResource Fg3}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Формат ответа" FontSize="13" Foreground="{StaticResource Fg2}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBox Text="{Binding Settings.AnswerFormat, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                 TextWrapping="Wrap" Height="96" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 Tag="Пусто — стандартный формат"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Опишите своими словами, как Claude должен отвечать: длина, стиль, списки или сплошной текст, нужен ли код. Применяется ко всем ответам, включая задачи и скриншоты. Пусто — стандартный формат: тезис, пункты, код."/>
                        <TextBlock Style="{StaticResource Label}" Text="Язык подсказок"/>
                        <ComboBox ItemsSource="{x:Static core:Catalog.AnswerLanguages}" SelectedValuePath="Id" DisplayMemberPath="Title" SelectedValue="{Binding Settings.AnswerLanguage}"/>
                        <DockPanel Margin="0,16,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Height="28" MinHeight="28" Content="Из файла…" Click="ImportResume_Click"/>
                            <TextBlock Text="Резюме" FontSize="13" Foreground="{StaticResource Fg2}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBox Text="{Binding Settings.Resume, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="128" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                        <DockPanel Margin="0,16,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Height="28" MinHeight="28" Content="Из файла…" Click="ImportJob_Click"/>
                            <TextBlock Text="Вакансия" FontSize="13" Foreground="{StaticResource Fg2}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBox Text="{Binding Settings.JobDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="96" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                        <TextBlock Style="{StaticResource Label}" Text="Дополнительно о себе (грейд, что подчеркнуть)"/>
                        <TextBox Text="{Binding Settings.ExtraInstructions, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="64" VerticalContentAlignment="Top"/>

                        <TextBlock Style="{StaticResource H}" Text="4. Окно"/>
                        <CheckBox Content="Скрывать окно при демонстрации экрана" IsChecked="{Binding Settings.HideFromCapture}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Проверьте тестовым звонком: окна не должно быть видно у собеседника (Windows 10 2004 и новее)."/>
                        <TextBlock Style="{StaticResource Label}" Text="Непрозрачность"/>
                        <Slider Minimum="0.4" Maximum="1" Value="{Binding Settings.Opacity}"/>
                        <TextBlock Style="{StaticResource Label}" Text="{Binding Settings.FontSize, StringFormat='Размер шрифта ответов: {0:0}'}"/>
                        <Slider Minimum="11" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.FontSize}"/>

                        <TextBlock Style="{StaticResource H}" Text="5. Горячие клавиши"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="Работают в любом приложении. Нажмите на сочетание и введите новое, Esc — отмена. Нужен Ctrl, Alt, Shift или Win (кроме F1–F12)."/>
                        <StackPanel x:Name="HotKeysPanel"/>
                        <Button Style="{StaticResource Btn}" Content="Сбросить" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ResetHotKeys_Click"/>

                        <TextBlock Style="{StaticResource H}" Text="6. Обновления"/>
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Проверить обновления" Click="CheckUpdates_Click"
                                    IsEnabled="{Binding NotUpdating}"/>
                            <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource Fg2}">
                                <Run Text="Установлена версия "/><Run Text="{Binding CurrentVersion, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Fg}"/>
                            </TextBlock>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding UpdateStatus}"
                                   Visibility="{Binding UpdateStatus, Converter={StaticResource TextToVis}}"/>
                        <StackPanel Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                            <Button Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Left" Height="36" Padding="16,0"
                                    Content="{Binding UpdateButtonText}" Click="InstallUpdate_Click" IsEnabled="{Binding NotUpdating}"/>
                            <ProgressBar Margin="0,12,0,0" Minimum="0" Maximum="100" Value="{Binding UpdateProgress}"
                                         Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="RedCast скачает новую версию с GitHub, заменит свои файлы и перезапустится. Настройки, резюме и модель речи сохранятся."/>
                        </StackPanel>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,32,0,16"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Btn}" Click="OpenSessions_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Foreground="{StaticResource Fg2}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Записи собеседований" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostBtn}" Content="Выйти из RedCast" Margin="8,0,0,0" Click="Quit_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>
