<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- One RedCast.exe instead of hundreds of .NET/WPF DLLs (only the Whisper engines in runtimes\ stay outside) -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <AssemblyName>RedCast</AssemblyName>
    <RootNamespace>RedCast</RootNamespace>
    <Product>RedCast</Product>
    <Version>2.6.1</Version>
    <ApplicationIcon>Assets\redcast.ico</ApplicationIcon>
    <Company>RedCast</Company>
    <Description>RedCast — ИИ-суфлёр для собеседований</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\redcast.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <!-- Whisper.net looks for its native engines in runtimes\<rid>\ next to the exe, so they are not bundled -->
  <Target Name="KeepWhisperRuntimesOutside" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('runtimes/'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <!-- Keep only the Windows x64 speech runtimes (CPU + Vulkan GPU) -->
  <Target Name="TrimRuntimes" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)runtimes/win-arm64;$(PublishDir)runtimes/win-x86;$(PublishDir)runtimes/vulkan/linux-x64" />
    <!-- List of this build's files: LegacyCleanup never deletes anything from it -->
    <ItemGroup>
      <_RedCastPublished Include="$(PublishDir)**/*" Exclude="$(PublishDir)RedCast.files" />
    </ItemGroup>
    <WriteLinesToFile File="$(PublishDir)RedCast.files" Lines="@(_RedCastPublished->'%(RecursiveDir)%(Filename)%(Extension)')" Overwrite="true" Encoding="UTF-8" />
  </Target>
</Project>
